# ==============================================
# SentinelAI - Environment Configuration Example
# Copy this file to .env and adjust values
# ==============================================

# Node.js Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/sentinelai

# Authentication & Security
JWT_SECRET=sentinelai_dev_secret_key_min_32_chars_long_example!
JWT_EXPIRES_IN=24h

# AI Service Integration
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=3000

# FastAPI AI Service Configuration
AI_PORT=8000
AI_HOST=127.0.0.1
AI_MODEL_VERSION=attack-classifier-v1
ANOMALY_MODEL_VERSION=behaviour-model-v1

# Frontend Configuration (Client)
VITE_API_BASE_URL=http://localhost:5000/api
